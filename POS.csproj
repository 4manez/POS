<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Update="application_config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\Sales\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="res\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>